Bootstrap: docker
From: pytorch/pytorch:2.2.0-cuda12.1-cudnn8-runtime
# Same CUDA/PyTorch base as baseline-gpu.def (proven on Komondor A100s).
# torch + CUDA + numpy<2 come from the base — do NOT reinstall them.

%labels
    Author gemacsanad
    Description GraphSAGE GPU container - ogbn-arxiv full-graph node classification + wandb

%environment
    export LC_ALL=C
    export PYTHONUNBUFFERED=1

%post
    pip install --no-cache-dir \
        torch_geometric==2.5.3 \
        pandas==2.2.2 \
        matplotlib==3.8.4 \
        wandb==0.28.0

%runscript
    cd /app
    exec python "$@"
