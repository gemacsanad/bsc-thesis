# OS
.DS_Store

# Secrets — matches .env at any depth
.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.venv_s2_download/
venv/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Data
#
# Large and regenerable, so not versioned. data/frozen/ is deliberately NOT
# ignored: eval_nodes.json, splits_eligible.json and training_sets.json define
# which nodes every experiment runs on, and a result is unreproducible without
# them. They are small (< 500 KB together).
# ---------------------------------------------------------------------------
data/raw/ogbn_arxiv/_ogb_cache/
data/raw/ogbn_arxiv/_titleabs.tsv
data/raw/ogbn_arxiv/node_features.npy
data/raw/ogbn_arxiv/nodes.csv
data/raw/ogbn_arxiv/edges.csv
data/raw/s2/
data/processed/joint/
data/processed/s2/
bulk_download_samples/

# Model weights and optimizer state (~196 MB per adapter epoch)
checkpoints/*
!checkpoints/.gitkeep
archive/graphsage_classification/*.pt

# HPC job logs and singularity images
logs/
*.sif

# DuckDB scratch space
duckdb_tmp/

# LaTeX build artifacts (thesis/)
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.xdv

# Local secrets (tracked until the final_model cleanup; rotate its keys before publishing)
.env_local
